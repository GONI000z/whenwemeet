rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // 내가 참여한 모임 목록: 나만 읽고 쓴다
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // 초대 코드 → 모임 연결: 만들 수만 있고 고치거나 지울 수 없다
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['gid']);
    }

    match /groups/{groupId} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid();
      // 모임 구성원은 누구나 모임 이름만 바꿀 수 있다
      allow update: if signedIn()
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30;

      // 구성원별 가능한 날짜와 이름: 본인 것만 쓴다
      match /members/{memberId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && uid() == memberId;
      }

      // 기타 일정: 등록한 사람만 고치고 지운다
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == uid();
        allow update: if signedIn() && resource.data.by == uid() && request.resource.data.by == uid();
        allow delete: if signedIn() && resource.data.by == uid();
      }
    }
  }
}
